---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import FaqList from "../components/FaqList.astro";
// Closing CTA banner is disabled for now; restore this import with the block at the end of the page.
// import CtaBanner from "../components/CtaBanner.astro";
import { faqGroups } from "../data/faq";
import heroTower from "../assets/images/hero-tower.jpg";
import thumbBoarding from "../assets/images/thumb-boarding.jpg";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqGroups.flatMap((group) =>
    group.items.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  ),
};
---

<BaseLayout
  title="Frequently asked questions"
  description="Common questions about airpport and SPACECAMPS: pricing, trials, support and what's next."
  schema={faqSchema}
>
  <Hero
    eyebrow="FAQ"
    title="Questions, answered"
    description="What people ask most about airpport and SPACECAMPS."
    background={heroTower}
    thumbnail={thumbBoarding}
  />

  <FaqList groups={faqGroups} description="Who we are and what we build." />

  {/*
  <CtaBanner
    eyebrow="Still have questions?"
    title="Ask us directly"
    description="If your question isn't covered here, send it to us and we'll answer it ourselves."
    primary={{ label: "Get in touch", href: "/contact/" }}
    secondary={{ label: "See products", href: "/products/" }}
  />
  */}
</BaseLayout>
