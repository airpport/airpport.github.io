---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PrinciplesBento from "../components/PrinciplesBento.astro";
// Closing CTA banner is disabled for now; restore this import with the block at the end of the page.
// import CtaBanner from "../components/CtaBanner.astro";
import Icon from "../components/Icon.astro";
import { site, spacecamps } from "../data/site";
import heroTerminal from "../assets/images/hero-terminal.jpg";
import thumbTower from "../assets/images/thumb-tower.jpg";

const values = [
  {
    icon: "compass",
    title: "Start with the operator",
    description:
      "We talk to the people doing the work before we write any code. Most good features start at the front desk.",
  },
  {
    icon: "sparkle",
    title: "Keep it simple",
    description:
      "Software should disappear into the day. If something needs a manual, we haven't finished designing it.",
  },
  {
    icon: "shield",
    title: "Price it fairly",
    description:
      "We'd rather charge a small flat fee for years than take a cut of every booking.",
  },
  {
    icon: "heart",
    title: "Be there when it matters",
    description:
      "Small businesses can't wait three days for a support ticket. You'll talk to the people who build the product.",
  },
] as const;
---

<BaseLayout
  title="About us"
  description="airpport is an independent, founder-led Australian software company making simple, fairly priced tools for small businesses, starting with caravan parks."
>
  <Hero
    eyebrow="About"
    title="Where small operators take off"
    description="airpport is an independent, founder-led software company building tools for Australian small businesses."
    trust={`Independent · Made in ${site.location}`}
    background={heroTerminal}
    thumbnail={thumbTower}
  />

  <section class="px-6 py-20 md:py-28">
    <div class="mx-auto max-w-5xl">
      <p data-reveal class="text-xs font-medium tracking-[0.18em] text-muted-foreground uppercase">Our story</p>
      <p data-reveal class="mt-6 text-2xl leading-[1.25] font-medium tracking-tight text-balance md:text-4xl">
        We started airpport because the small businesses we know best were stuck
        with <span class="text-muted-foreground">clunky, expensive software that took a cut of every sale.</span>
      </p>
      <div class="mt-12 grid gap-8 text-base leading-relaxed text-muted-foreground md:grid-cols-2 md:text-lg">
        <p data-reveal>
          Caravan parks are a good example. Many still run on phone calls and paper diaries, or pay a booking platform a
          commission on every stay. So we
          built <a href={spacecamps.url} target="_blank" rel="noopener" class="font-medium text-foreground underline underline-offset-4">SPACECAMPS</a>,
          a booking system with a flat monthly price.
        </p>
        <p data-reveal style="--reveal-delay:100ms">
          We plan to do the same in other industries. We listen to the people doing the work, build the simplest thing
          that makes their day easier, and keep improving it with them. SPACECAMPS is the first departure on the board.
        </p>
      </div>
    </div>
  </section>

  <section class="px-6 py-20 md:py-28">
    <div class="mx-auto max-w-6xl">
      <SectionHeading
        eyebrow="Values"
        title="What we stand for"
        description="Four rules behind every product we ship."
      />
      <div class="grid gap-5 sm:grid-cols-2">
        {
          // Reveal on a wrapper: its transition rule would otherwise replace the card's hover transition.
          values.map((value, i) => (
            <div data-reveal style={`--reveal-delay:${(i % 2) * 100}ms`}>
              <div class="group h-full rounded-[1.75rem] border border-border bg-card p-7 transition-colors hover:bg-foreground hover:text-background md:p-9">
                <div class="flex items-center justify-between">
                  <span class="grid h-11 w-11 place-items-center rounded-full border border-border transition-colors group-hover:border-background/20">
                    <Icon name={value.icon} class="h-[18px] w-[18px]" />
                  </span>
                  <span class="text-sm font-medium text-muted-foreground transition-colors group-hover:text-background/60">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                </div>
                <h3 class="mt-10 text-2xl font-medium tracking-tight">{value.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-muted-foreground transition-colors group-hover:text-background/70 md:text-base">
                  {value.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="px-6 py-20 md:py-28">
    <SectionHeading
      eyebrow="How we work"
      title="Small team, fair software"
      description="What to expect from anything we make."
    />
    <PrinciplesBento />
  </section>

  {/*
  <CtaBanner
    eyebrow="Say hello"
    title="Have a problem worth solving?"
    description="Tell us what's slowing your business down. It could be our next product."
    primary={{ label: "Get in touch", href: "/contact/" }}
    secondary={{ label: "See SPACECAMPS", href: "/products/" }}
  />
  */}
</BaseLayout>
