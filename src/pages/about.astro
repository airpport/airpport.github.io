---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PrinciplesBento from "../components/PrinciplesBento.astro";
// Closing CTA banner is disabled for now; restore this import with the block at the end of the page.
// import CtaBanner from "../components/CtaBanner.astro";
import Icon from "../components/Icon.astro";
import { site, spacecamps } from "../data/site";

const values = [
  {
    icon: "compass",
    title: "Start with the operator",
    description:
      "We spend time with the people doing the work before writing a line of code. The best features come from a conversation at the front desk.",
  },
  {
    icon: "sparkle",
    title: "Keep it simple",
    description:
      "Software should disappear into the day. If something needs a manual, we haven't finished designing it.",
  },
  {
    icon: "shield",
    title: "Price it fairly",
    description:
      "Flat, transparent pricing. We'd rather earn a small monthly fee for years than take a cut of every booking.",
  },
  {
    icon: "heart",
    title: "Be there when it matters",
    description:
      "Small businesses can't wait three days for a support ticket. You'll talk to the people who build the product.",
  },
] as const;
---

<BaseLayout
  title="About"
  description="airpport is an independent, founder-led Australian software company building fair, simple tools for small operators."
>
  <Hero
    eyebrow="About"
    title="Where small operators take off"
    description="airpport is an independent, founder-led software company. We build focused products for the industries that keep Australia moving."
    trust={`Independent · Made in ${site.location}`}
    background="/images/hero-terminal.jpg"
    thumbnail="/images/thumb-tower.jpg"
  />

  <section class="px-6 py-20 md:py-28">
    <div class="mx-auto max-w-5xl">
      <p data-reveal class="text-xs font-medium tracking-[0.18em] text-muted-foreground uppercase">Our story</p>
      <p data-reveal class="mt-6 text-2xl leading-[1.25] font-medium tracking-tight text-balance md:text-4xl">
        Every journey starts at a port. We started airpport because the small businesses we know best were stuck with
        <span class="text-muted-foreground">clunky, expensive software that took a cut of everything they earned.</span>
      </p>
      <div class="mt-12 grid gap-8 text-base leading-relaxed text-muted-foreground md:grid-cols-2 md:text-lg">
        <p data-reveal>
          Caravan parks are a perfect example. They host countless family holidays, yet many still juggle phone calls, paper
          diaries and booking platforms that charge a commission on every stay. So we built
          <a href={spacecamps.url} target="_blank" rel="noopener" class="font-medium text-foreground underline underline-offset-4">Spacecamps</a>
          — a modern booking system with a flat monthly price.
        </p>
        <p data-reveal style="--reveal-delay:100ms">
          That's the airpport approach: find an industry that's underserved, listen carefully, and build the simplest
          product that genuinely makes the day easier. Then keep improving it alongside the people who use it. Spacecamps
          is our first departure — there are more on the board.
        </p>
      </div>
    </div>
  </section>

  <section class="px-6 py-20 md:py-28">
    <div class="mx-auto max-w-6xl">
      <SectionHeading
        eyebrow="Values"
        title="What we stand for"
        description="Four promises that shape every product we put our name to."
      />
      <div class="grid gap-5 sm:grid-cols-2">
        {
          values.map((value, i) => (
            <div
              data-reveal
              style={`--reveal-delay:${(i % 2) * 100}ms`}
              class="group rounded-[1.75rem] border border-border bg-card p-7 transition-colors hover:bg-foreground hover:text-background md:p-9"
            >
              <div class="flex items-center justify-between">
                <span class="grid h-11 w-11 place-items-center rounded-full border border-border transition-colors group-hover:border-background/20">
                  <Icon name={value.icon} class="h-[18px] w-[18px]" />
                </span>
                <span class="text-sm font-medium text-muted-foreground transition-colors group-hover:text-background/60">
                  {String(i + 1).padStart(2, "0")}
                </span>
              </div>
              <h3 class="mt-10 text-2xl font-medium tracking-tight">{value.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground transition-colors group-hover:text-background/70 md:text-base">
                {value.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="px-6 py-20 md:py-28">
    <SectionHeading
      eyebrow="How we work"
      title="Small team, fair software"
      description="What you can expect from anything with the airpport name on it."
    />
    <PrinciplesBento />
  </section>

  {/*
  <CtaBanner
    eyebrow="Say hello"
    title="Have a problem worth solving?"
    description="We're always looking for the next industry that deserves better tools. Tell us what's slowing your business down."
    primary={{ label: "Get in touch", href: "/contact" }}
    secondary={{ label: "See Spacecamps", href: "/products" }}
  />
  */}
</BaseLayout>
