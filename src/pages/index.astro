---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroTabs from "../components/HeroTabs.astro";
import StatsRow from "../components/StatsRow.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProductCards from "../components/ProductCards.astro";
import PrinciplesBento from "../components/PrinciplesBento.astro";
import SpacecampsShowcase from "../components/SpacecampsShowcase.astro";
import FaqList from "../components/FaqList.astro";
// Closing CTA banner is disabled for now; restore this import with the block at the end of the page.
// import CtaBanner from "../components/CtaBanner.astro";
import Icon from "../components/Icon.astro";
import { site, spacecamps } from "../data/site";
import { faqGroups } from "../data/faq";
import heroNight from "../assets/images/hero-night.jpg";
import heroRunway from "../assets/images/hero-runway.jpg";
import heroSky from "../assets/images/hero-sky.jpg";

const tabs = [
  {
    key: "company",
    label: "airpport",
    eyebrow: "Independent software company",
    title: "Software that gets small operators off the ground",
    description:
      "We build simple tools for Australian small businesses, starting with caravan parks.",
    image: heroSky,
    cta: { label: "About us", href: "/about/" },
  },
  {
    key: "spacecamps",
    label: "SPACECAMPS",
    eyebrow: "Product 01 · Live now",
    title: "Your park takes the bookings. We don't take a cut.",
    description: spacecamps.summary,
    image: heroNight,
    cta: { label: "spacecamps.com.au", href: spacecamps.url },
  },
  {
    key: "next",
    label: "What's next",
    eyebrow: "Cleared for take-off",
    title: "More products are on the runway.",
    description:
      "SPACECAMPS is the first departure. The next product is already in the works.",
    image: heroRunway,
    // Contact page is disabled for now; restore this link with src/pages/_contact.astro.
    // cta: { label: "Get in touch", href: "/contact/" },
  },
];
---

<BaseLayout title={site.name}>
  <HeroTabs tabs={tabs} trust="Made in Australia" />

  <StatsRow
    items={[
      { value: "01", label: "Product live" },
      { value: "100%", label: "Independent" },
      { value: "0%", label: "Commission on stays" },
      { value: "AU", label: "Owned & operated" },
    ]}
  />

  <section class="px-6 py-20 md:py-28">
    <div class="mx-auto max-w-6xl">
      <SectionHeading
        eyebrow="Products"
        title="What we build"
        description="Software for industries the big platforms overlook, built one product at a time."
      />
      <ProductCards />
    </div>
  </section>

  <section class="px-6 py-20 md:py-28">
    <SectionHeading
      eyebrow="How we work"
      title="Small team, fair software"
      description="We'd rather build one thing people love than ten they put up with."
    />
    <PrinciplesBento />
  </section>

  <section class="px-6 py-20 md:py-28">
    <SectionHeading
      eyebrow="Spotlight · SPACECAMPS"
      title="Everything a park needs to take bookings"
      description="Guests book, pay and check in from their phone, so fewer of them need to ring you."
    />
    <SpacecampsShowcase />
    <div class="mt-10 flex justify-center" data-reveal>
      <a
        href={spacecamps.url}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full bg-foreground px-6 py-3 text-sm font-medium text-background transition-transform hover:-translate-y-0.5"
      >
        Start a free 30-day trial
        <Icon name="arrow-up-right" />
      </a>
    </div>
  </section>

  <FaqList groups={faqGroups.slice(0, 2)} description="What people ask us most." />

  {/*
  <CtaBanner
    eyebrow="Ready for take-off?"
    title="Let's get your business off the ground"
    description="Run a caravan park? Try SPACECAMPS. Got a different problem? Tell us about it."
    primary={{ label: "Try SPACECAMPS", href: spacecamps.url }}
    secondary={{ label: "Get in touch", href: "/contact/" }}
  />
  */}
</BaseLayout>
