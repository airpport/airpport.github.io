---
import { nav } from "../data/site";
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 w-full px-4 pt-4">
  <nav
    aria-label="Main"
    class="relative z-50 mx-auto flex max-w-5xl items-center justify-between rounded-full border border-border/60 bg-foreground/95 px-2 py-2 text-background shadow-[0_8px_30px_rgb(0,0,0,0.12)] backdrop-blur"
  >
    <a href="/" class="flex items-center pl-4 pr-2" aria-label="airpport home">
      <!-- The bar is dark in light mode and light in dark mode, so swap the wordmark to match. -->
      <img src="/logo-white.svg" alt="" width="978" height="204" class="h-[22px] w-auto dark:hidden" />
      <img src="/logo.svg" alt="" width="978" height="204" class="hidden h-[22px] w-auto dark:block" />
    </a>

    <ul class="hidden items-center gap-1 text-sm md:flex">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "rounded-full px-3 py-1.5 transition-colors",
                isActive(item.href) ? "bg-background/15 text-background" : "text-background/70 hover:text-background",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2 pr-1">
      <ThemeToggle class="hidden sm:grid" />
      <a
        href="/contact"
        class="hidden rounded-full bg-background px-4 py-2 text-sm font-medium text-foreground transition-transform hover:-translate-y-0.5 hover:shadow-md sm:inline-flex"
      >
        Get in touch
      </a>
      <button
        type="button"
        id="mobile-menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid h-9 w-9 place-items-center rounded-full bg-background text-foreground md:hidden"
      >
        <svg class="menu-icon h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="8" x2="20" y2="8"></line>
          <line x1="4" y1="16" x2="20" y2="16"></line>
        </svg>
        <svg class="close-icon hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Invisible layer behind the open menu; tapping it closes the menu. -->
  <div
    id="mobile-menu-backdrop"
    aria-hidden="true"
    class="pointer-events-none fixed inset-0 z-30 md:hidden"
  ></div>

  <div
    id="mobile-menu"
    class="pointer-events-none fixed inset-x-4 top-20 z-40 origin-top scale-95 rounded-3xl border border-border/60 bg-foreground/95 p-6 text-background opacity-0 shadow-[0_20px_60px_rgb(0,0,0,0.25)] backdrop-blur transition-all duration-300 md:hidden"
  >
    <ul class="flex flex-col gap-1 text-base">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "block rounded-2xl px-4 py-3 transition-colors",
                isActive(item.href)
                  ? "bg-background/15 text-background"
                  : "text-background/75 hover:bg-background/10 hover:text-background",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-4 flex items-center gap-3">
      <a
        href="/contact"
        class="inline-flex flex-1 items-center justify-center rounded-full bg-background px-5 py-3 text-sm font-medium text-foreground"
      >
        Get in touch
      </a>
      <ThemeToggle class="h-11! w-11!" />
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const backdrop = document.getElementById("mobile-menu-backdrop");

  function setOpen(open: boolean) {
    if (!btn || !menu) return;
    menu.classList.toggle("opacity-0", !open);
    menu.classList.toggle("pointer-events-none", !open);
    menu.classList.toggle("scale-95", !open);
    backdrop?.classList.toggle("pointer-events-none", !open);
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    btn.querySelector(".menu-icon")?.classList.toggle("hidden", open);
    btn.querySelector(".close-icon")?.classList.toggle("hidden", !open);
    // Lock scroll on <html>, not <body>: html's overflow-x: clip stops body's overflow reaching the viewport,
    // so overflow: hidden on body would make it a scroll container and the sticky header would scroll away.
    document.documentElement.style.overflow = open ? "hidden" : "";
  }

  btn?.addEventListener("click", () => setOpen(btn.getAttribute("aria-expanded") !== "true"));
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  backdrop?.addEventListener("click", () => setOpen(false));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
  window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => e.matches && setOpen(false));
</script>
