---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: "center" | "left";
}
const { eyebrow, title, description, align = "center" } = Astro.props;
---

<div
  data-reveal
  class:list={["mb-12 flex flex-col gap-4 md:mb-16", align === "center" ? "items-center text-center" : "items-start text-left"]}
>
  <span
    class="inline-flex items-center rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-muted-foreground"
  >
    {eyebrow}
  </span>
  <h2 class="max-w-3xl text-3xl font-medium tracking-tight text-balance md:text-5xl">{title}</h2>
  {description && <p class="max-w-2xl text-base text-pretty text-muted-foreground md:text-lg">{description}</p>}
</div>
