---
interface Props {
  class?: string;
}
const { class: className = "h-6 w-6" } = Astro.props;
---

<svg viewBox="0 0 32 32" class={className} aria-hidden="true">
  <circle cx="16" cy="16" r="7" fill="currentColor"></circle>
  <ellipse
    cx="16"
    cy="16"
    rx="14"
    ry="4.6"
    fill="none"
    stroke="var(--brand)"
    stroke-width="2"
    transform="rotate(-20 16 16)"></ellipse>
  <path d="M9.4 13.2a7 7 0 0 1 13.2 0" fill="currentColor"></path>
</svg>
