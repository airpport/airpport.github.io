---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";

const card = "relative overflow-hidden rounded-[1.75rem] border border-border bg-card p-7";
---

<div class="mx-auto grid max-w-6xl gap-5 md:grid-cols-3">
  <!-- column 1 -->
  <div class="flex flex-col gap-5">
    <div data-reveal class="relative grid h-[300px] place-items-center overflow-hidden rounded-[1.75rem] bg-[#0a0a0a] text-white">
      <div
        class="absolute inset-0 opacity-40 [background-image:linear-gradient(rgb(255_255_255/0.08)_1px,transparent_1px),linear-gradient(90deg,rgb(255_255_255/0.08)_1px,transparent_1px)] [background-size:33.33%_33.33%]"
      >
      </div>
      <Logo class="relative h-20 w-20 text-white" />
      <p class="absolute bottom-6 left-7 text-[11px] tracking-[0.18em] text-white/55 uppercase">Small team · Big sky</p>
    </div>
    <div
      data-reveal
      class="relative grid h-[220px] place-items-center overflow-hidden rounded-[1.75rem] bg-[#141821] text-white"
      style="--reveal-delay:80ms; background-image: radial-gradient(circle at 30% 20%, #4a5a7a, transparent 60%), radial-gradient(ellipse at 50% 115%, #f0b48acc, transparent 60%)"
    >
      <span class="text-4xl font-semibold tracking-[-0.05em]">airpport<span class="text-brand">.</span></span>
      <div class="absolute inset-x-7 bottom-6 flex justify-between" aria-hidden="true">
        {Array.from({ length: 14 }, () => <span class="h-1 w-1 rounded-full bg-[#ffd79a]/80"></span>)}
      </div>
    </div>
  </div>

  <!-- column 2 -->
  <div class="flex flex-col gap-5">
    <div data-reveal style="--reveal-delay:120ms" class:list={[card, "h-[220px]"]}>
      <div class="flex items-center justify-between text-sm font-medium">
        <span class="flex items-center gap-2"><span class="h-1.5 w-8 rounded-full bg-foreground"></span>Idea</span>
        <span class="text-muted-foreground">Shipped</span>
      </div>
      <div class="mt-5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
        <div class="progress h-full rounded-full bg-foreground"></div>
      </div>
      <p class="absolute right-7 bottom-7 left-7 text-sm leading-relaxed text-muted-foreground">
        We talk to operators first, build the smallest thing that helps, then keep improving it with them.
      </p>
    </div>
    <div data-reveal style="--reveal-delay:200ms" class:list={[card, "flex h-[300px] flex-col justify-between"]}>
      <p class="text-7xl font-medium tracking-[-0.06em] md:text-8xl">0%</p>
      <p class="text-sm leading-relaxed text-muted-foreground">
        <span class="font-medium text-foreground">commission on stays.</span> You pay one flat monthly fee, however many
        nights you sell.
      </p>
    </div>
  </div>

  <!-- column 3 -->
  <div class="flex flex-col gap-5">
    <div
      data-reveal
      style="--reveal-delay:160ms"
      class="relative flex h-[300px] flex-col items-end justify-end overflow-hidden rounded-[1.75rem] bg-[radial-gradient(circle_at_70%_20%,#2a2a2a,#0a0a0a_70%)] p-7 text-white"
    >
      <div class="grid h-24 w-24 place-items-center rounded-full bg-white/10">
        <Icon name="heart" class="h-9 w-9" />
      </div>
      <p class="mt-4 text-[11px] tracking-[0.18em] text-white/60 uppercase">Founder-led support</p>
    </div>
    <div data-reveal style="--reveal-delay:240ms" class:list={[card, "flex h-[220px] flex-col justify-center gap-2.5 p-5"]}>
      <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs font-medium text-emerald-700 shadow-sm dark:border-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-300">
        ✓ Booking confirmed · Site 14, 3 nights
      </div>
      <div class="ml-2 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-medium text-amber-700 shadow-sm dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-300">
        ✉ Check-in email sent
      </div>
      <div class="rounded-xl border border-border bg-background px-3 py-2 shadow-sm">
        <p class="text-xs font-medium">Check-in</p>
        <p class="text-[11px] text-muted-foreground">Friday · from 2:00pm</p>
      </div>
    </div>
  </div>

  <!-- bottom row -->
  <div data-reveal class:list={[card, "h-[200px]"]}>
    <p class="text-[11px] tracking-[0.18em] text-muted-foreground uppercase">Try before you buy</p>
    <div class="mt-6 flex items-center gap-4">
      <div class="relative grid h-20 w-20 place-items-center">
        <svg viewBox="0 0 80 80" class="absolute inset-0 -rotate-90">
          <circle cx="40" cy="40" r="35" fill="none" stroke="var(--border)" stroke-width="6"></circle>
          <circle cx="40" cy="40" r="35" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-dasharray="220" stroke-dashoffset="0"></circle>
        </svg>
        <span class="text-sm font-semibold">30d</span>
      </div>
      <p class="text-sm leading-relaxed text-muted-foreground">Free trial, no credit card to start, cancel any time.</p>
    </div>
  </div>
  <div data-reveal style="--reveal-delay:80ms" class:list={[card, "h-[200px]"]}>
    <p class="text-[11px] tracking-[0.18em] text-muted-foreground uppercase">Built for</p>
    <p class="mt-6 text-4xl font-medium tracking-tight md:text-5xl">Australia</p>
    <div class="mt-4 h-1.5 w-full rounded-full bg-[repeating-linear-gradient(90deg,var(--foreground)_0_10px,transparent_10px_16px)] opacity-20"></div>
  </div>
  <div data-reveal style="--reveal-delay:160ms" class:list={[card, "h-[200px]"]}>
    <p class="text-[11px] tracking-[0.18em] text-muted-foreground uppercase">What we care about</p>
    <div class="mt-8 flex flex-wrap gap-2">
      {
        ["Simple", "Fast", "Fair pricing", "Mobile-first", "Human support"].map((chip) => (
          <span class="rounded-full border border-border bg-background px-3 py-1 text-xs font-medium">{chip}</span>
        ))
      }
    </div>
  </div>
</div>

<style>
  .progress {
    width: 20%;
    transition: width 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.3s;
  }
  :global(.is-visible) .progress {
    width: 100%;
  }
  :global(html:not(.js)) .progress {
    width: 100%;
  }
</style>
