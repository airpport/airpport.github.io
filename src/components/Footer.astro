---
import { site, spacecamps } from "../data/site";
import Icon from "./Icon.astro";

const columns = [
  {
    title: "Company",
    links: [
      { label: "About", href: "/about" },
      { label: "Products", href: "/products" },
      { label: "Contact", href: "/contact" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "FAQ", href: "/faq" },
      { label: "Sitemap", href: "/sitemap-index.xml" },
    ],
  },
  {
    title: "Products",
    links: [{ label: spacecamps.name, href: spacecamps.url, external: true }],
  },
];
const year = new Date().getFullYear();
---

<footer class="px-4 pt-20 pb-4 md:pt-32">
  <div class="relative mx-auto max-w-7xl overflow-hidden rounded-[2.5rem] bg-foreground text-background">
    <div class="grid gap-10 px-8 pt-12 pb-0 md:grid-cols-[1.4fr_repeat(3,1fr)] md:gap-12 md:px-14 md:pt-16">
      <div class="space-y-5">
        <p class="text-xs tracking-[0.18em] text-background/50 uppercase">Email</p>
        <a
          href={`mailto:${site.email}`}
          class="block text-xl font-medium tracking-tight break-all transition-opacity hover:opacity-70 md:text-2xl"
        >
          {site.email}
        </a>
        <p class="max-w-xs text-sm text-background/60">
          Independent software, made in {site.location}.
        </p>
      </div>
      {
        columns.map((col) => (
          <div class="space-y-4">
            <h4 class="text-xs tracking-[0.18em] text-background/50 uppercase">{col.title}</h4>
            <ul class="space-y-2 text-sm">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={"external" in link ? "_blank" : undefined}
                    rel={"external" in link ? "noopener" : undefined}
                    class="inline-flex items-center gap-1 text-background/85 transition-colors hover:text-background"
                  >
                    {link.label}
                    {"external" in link && <Icon name="arrow-up-right" class="h-3 w-3 opacity-60" />}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="px-8 pt-10 pb-6 md:px-14">
      <div class="flex gap-3">
        <a
          href={`mailto:${site.email}`}
          aria-label="Email"
          class="grid h-9 w-9 place-items-center rounded-full border border-background/20 text-background/80 transition-colors hover:border-background hover:bg-background hover:text-foreground"
        >
          <Icon name="mail" />
        </a>
        <a
          href={spacecamps.url}
          target="_blank"
          rel="noopener"
          aria-label="SPACECAMPS website"
          class="grid h-9 w-9 place-items-center rounded-full border border-background/20 text-background/80 transition-colors hover:border-background hover:bg-background hover:text-foreground"
        >
          <Icon name="tent" />
        </a>
        <a
          href={site.url}
          aria-label="airpport website"
          class="grid h-9 w-9 place-items-center rounded-full border border-background/20 text-background/80 transition-colors hover:border-background hover:bg-background hover:text-foreground"
        >
          <Icon name="globe" />
        </a>
      </div>
    </div>

    <div class="px-6 pb-2 md:px-12">
      <p
        class="block max-w-full truncate text-[21vw] leading-[0.85] font-semibold tracking-[-0.06em] select-none md:text-[15.5vw] xl:text-[13.2rem]"
        aria-hidden="true"
      >
        airpport<span class="text-brand">.</span>
      </p>
    </div>

    <div
      class="flex flex-col items-start justify-between gap-3 border-t border-background/10 px-8 py-5 text-xs text-background/60 md:flex-row md:items-center md:px-14"
    >
      <div class="flex flex-wrap gap-5">
        <a href="/faq" class="transition-colors hover:text-background">FAQ</a>
        <a href="/contact" class="transition-colors hover:text-background">Contact</a>
        <a href="#main" class="transition-colors hover:text-background">Back to top ↑</a>
      </div>
      <p>© {year} {site.legalName}. All rights reserved.</p>
    </div>
  </div>
</footer>
