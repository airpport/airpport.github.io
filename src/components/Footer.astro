---
import { site, spacecamps } from "../data/site";
import Icon from "./Icon.astro";

const columns = [
  {
    title: "Company",
    links: [
      { label: "About", href: "/about" },
      { label: "Products", href: "/products" },
      // Contact page is disabled for now; restore with src/pages/_contact.astro.
      // { label: "Contact", href: "/contact" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "FAQ", href: "/faq" },
      { label: "Privacy policy", href: "/privacy" },
      { label: "Terms and conditions", href: "/terms" },
    ],
  },
  {
    title: "Products",
    links: [{ label: spacecamps.name, href: spacecamps.url, external: true }],
  },
];
const year = new Date().getFullYear();
---

<footer class="px-6 pt-20 pb-4 md:pt-32">
  <div class="relative mx-auto max-w-6xl overflow-hidden rounded-[2.5rem] bg-foreground text-background">
    <div class="flex flex-col gap-10 px-8 pt-12 pb-6 md:flex-row md:gap-24 md:px-14 md:pt-16 md:pb-14">
      {
        columns.map((col) => (
          <div class="space-y-4">
            <h2 class="text-xs tracking-[0.18em] text-background/50 uppercase">{col.title}</h2>
            <ul class="space-y-2 text-sm">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={"external" in link ? "_blank" : undefined}
                    rel={"external" in link ? "noopener" : undefined}
                    class="inline-flex items-center gap-1 text-background/85 transition-colors hover:text-background"
                  >
                    {link.label}
                    {"external" in link && <Icon name="arrow-up-right" class="h-3 w-3 opacity-60" />}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      {/* Top right on desktop; below the link columns on mobile. */}
      <div class="flex gap-3 md:ml-auto">
        {/* Email is hidden for now.
        <a
          href={`mailto:${site.email}`}
          aria-label="Email"
          class="grid h-9 w-9 place-items-center rounded-full border border-background/20 text-background/80 transition-colors hover:border-background hover:bg-background hover:text-foreground"
        >
          <Icon name="mail" />
        </a>
        */}
        <a
          href={spacecamps.url}
          target="_blank"
          rel="noopener"
          aria-label="Spacecamps website"
          class="grid h-9 w-9 place-items-center rounded-full border border-background/20 text-background/80 transition-colors hover:border-background hover:bg-background hover:text-foreground"
        >
          <Icon name="tent" />
        </a>
        <a
          href={site.url}
          aria-label="airpport website"
          class="grid h-9 w-9 place-items-center rounded-full border border-background/20 text-background/80 transition-colors hover:border-background hover:bg-background hover:text-foreground"
        >
          <Icon name="globe" />
        </a>
      </div>
    </div>

    <div class="@container px-6 pb-2 md:px-12">
      <p
        class="block max-w-full truncate text-[25cqw] leading-[0.85] font-semibold tracking-[-0.03em] select-none md:text-[15.5vw] xl:text-[13.2rem]"
        aria-hidden="true"
      >
        airpport<span class="text-brand">.</span>
      </p>
    </div>

    <div
      class="flex flex-col items-start justify-between gap-3 border-t border-background/10 px-8 py-5 text-xs text-background/60 md:flex-row md:items-center md:px-14"
    >
      <div class="flex flex-wrap gap-5">
        <a href="/privacy" class="transition-colors hover:text-background">Privacy</a>
        <a href="/terms" class="transition-colors hover:text-background">Terms</a>
        {/* <a href="/contact" class="transition-colors hover:text-background">Contact</a> */}
        <a href="#main" class="transition-colors hover:text-background">Back to top ↑</a>
      </div>
      <p>© {year} {site.legalName}. All rights reserved.</p>
    </div>
  </div>
</footer>
