---
import Icon from "./Icon.astro";
import { spacecamps } from "../data/site";

interface Props {
  /** Artwork for the SPACECAMPS card, so each page can show something different. */
  image?: string;
  imageAlt?: string;
}
const {
  image = "/images/product-caravan.jpg",
  imageAlt = "Illustration of a caravan under string lights beside a campfire at dusk",
} = Astro.props;
---

<div class="grid gap-5 md:grid-cols-3">
  <a
    href={spacecamps.url}
    target="_blank"
    rel="noopener"
    data-reveal
    class="group relative flex min-h-[460px] flex-col justify-between overflow-hidden rounded-[2rem] bg-[#14161f] p-7 text-white md:col-span-2 md:min-h-[520px] md:p-10"
  >
    <img
      src={image}
      alt={imageAlt}
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-[1.04]"
    />
    <div class="absolute inset-0 bg-linear-to-b from-black/30 via-transparent to-black/60"></div>

    <div class="relative flex items-start justify-between gap-4">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-3 py-1 text-xs font-medium backdrop-blur"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
        Live · Product 01
      </span>
      <span
        class="grid h-10 w-10 place-items-center rounded-full bg-white text-black transition-transform group-hover:rotate-45"
      >
        <Icon name="arrow-up-right" />
      </span>
    </div>

    <div class="relative max-w-lg">
      <p class="text-xs tracking-[0.18em] text-white/70 uppercase">spacecamps.com.au</p>
      <h3 class="mt-3 text-3xl font-medium tracking-tight md:text-5xl">{spacecamps.name}</h3>
      <p class="mt-3 text-sm leading-relaxed text-white/80 md:text-base">{spacecamps.summary}</p>
      <div class="mt-5 flex flex-wrap gap-2">
        {
          ["Bookings", "Park map", "Payments", "Guest emails"].map((tag) => (
            <span class="rounded-full border border-white/20 px-3 py-1 text-xs text-white/85">{tag}</span>
          ))
        }
      </div>
    </div>
  </a>

  <div
    data-reveal
    style="--reveal-delay:120ms"
    class="relative flex min-h-[380px] flex-col justify-between overflow-hidden rounded-[2rem] border border-dashed border-border bg-card p-7 md:p-8"
  >
    <div class="bg-dots absolute inset-0 opacity-60"></div>
    <div class="relative flex items-start justify-between">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-3 py-1 text-xs font-medium text-muted-foreground"
      >
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-brand"></span>
        In the hangar
      </span>
      <span class="text-xs font-medium text-muted-foreground">02</span>
    </div>
    <div class="relative grid flex-1 place-items-center py-8">
      <div class="relative h-28 w-28" aria-hidden="true">
        <div class="absolute inset-0 rounded-full border border-foreground/25"></div>
        <div class="absolute inset-[22%] rounded-full border border-dashed border-foreground/20"></div>
        <div class="absolute inset-x-0 top-1/2 h-px bg-foreground/15"></div>
        <div class="absolute inset-y-0 left-1/2 w-px bg-foreground/15"></div>
        <div class="radar-sweep absolute inset-0 rounded-full"></div>
        <span class="blip absolute top-[24%] left-[66%] h-2 w-2 rounded-full bg-brand"></span>
        <span class="absolute top-1/2 left-1/2 h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-foreground"></span>
      </div>
    </div>
    <div class="relative">
      <h3 class="text-2xl font-medium tracking-tight">Product 02</h3>
      <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
        We’re building something for another overlooked industry. Want a heads-up when it launches?
      </p>
      <a href="/contact/" class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium hover:underline">
        Get notified <Icon name="arrow-right" class="h-3.5 w-3.5" />
      </a>
    </div>
  </div>
</div>

<style>
  .radar-sweep {
    background: conic-gradient(from 0deg, transparent 0 290deg, color-mix(in oklab, var(--brand) 45%, transparent) 360deg);
    animation: spin 4s linear infinite;
  }
  .blip {
    animation: blip 4s ease-out infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes blip {
    0%,
    8% {
      opacity: 1;
      transform: scale(1.4);
    }
    60%,
    100% {
      opacity: 0.25;
      transform: scale(1);
    }
  }
</style>
