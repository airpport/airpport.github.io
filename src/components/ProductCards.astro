---
import Icon from "./Icon.astro";
import { spacecamps } from "../data/site";
---

<div class="grid gap-5 md:grid-cols-3">
  <a
    href={spacecamps.url}
    target="_blank"
    rel="noopener"
    data-reveal
    class="group relative flex min-h-[460px] flex-col justify-between overflow-hidden rounded-[2rem] bg-[#0b0b18] p-7 text-white md:col-span-2 md:min-h-[520px] md:p-10"
  >
    <img
      src="/images/hero-night.jpg"
      alt="Illustration of tents glowing under a starry sky"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-[1.04]"
    />
    <div class="absolute inset-0 bg-linear-to-b from-black/30 via-transparent to-black/60"></div>

    <div class="relative flex items-start justify-between gap-4">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-3 py-1 text-xs font-medium backdrop-blur"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
        Live · Product 01
      </span>
      <span
        class="grid h-10 w-10 place-items-center rounded-full bg-white text-black transition-transform group-hover:rotate-45"
      >
        <Icon name="arrow-up-right" />
      </span>
    </div>

    <div class="relative max-w-lg">
      <p class="text-xs tracking-[0.18em] text-white/70 uppercase">spacecamps.com.au</p>
      <h3 class="mt-3 text-3xl font-medium tracking-tight md:text-5xl">{spacecamps.name}</h3>
      <p class="mt-3 text-sm leading-relaxed text-white/80 md:text-base">{spacecamps.summary}</p>
      <div class="mt-5 flex flex-wrap gap-2">
        {
          ["Bookings", "Park map", "Payments", "Guest emails"].map((tag) => (
            <span class="rounded-full border border-white/20 px-3 py-1 text-xs text-white/85">{tag}</span>
          ))
        }
      </div>
    </div>
  </a>

  <div
    data-reveal
    style="--reveal-delay:120ms"
    class="relative flex min-h-[380px] flex-col justify-between overflow-hidden rounded-[2rem] border border-dashed border-border bg-card p-7 md:p-8"
  >
    <div class="bg-dots absolute inset-0 opacity-60"></div>
    <div class="relative flex items-start justify-between">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-3 py-1 text-xs font-medium text-muted-foreground"
      >
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-brand"></span>
        In the hangar
      </span>
      <span class="text-xs font-medium text-muted-foreground">02</span>
    </div>
    <div class="relative grid flex-1 place-items-center py-8">
      <div class="relative h-28 w-28">
        <div class="absolute inset-0 rounded-full border border-dashed border-foreground/25"></div>
        <div class="absolute inset-5 rounded-full bg-foreground"></div>
        <div class="orbit absolute inset-0">
          <span class="absolute -top-1.5 left-1/2 h-3 w-3 -translate-x-1/2 rounded-full bg-brand"></span>
        </div>
      </div>
    </div>
    <div class="relative">
      <h3 class="text-2xl font-medium tracking-tight">Product 02</h3>
      <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
        Something new is being built for another overlooked industry. Want a heads-up when it’s ready for take-off?
      </p>
      <a href="/contact" class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium hover:underline">
        Get notified <Icon name="arrow-right" class="h-3.5 w-3.5" />
      </a>
    </div>
  </div>
</div>

<style>
  .orbit {
    animation: spin 9s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
