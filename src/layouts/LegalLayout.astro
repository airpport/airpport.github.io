---
import BaseLayout from "./BaseLayout.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  summary: string;
}

const { title, description, summary } = Astro.props;
const updated = new Date(`${site.legalUpdated}T00:00:00`).toLocaleDateString("en-AU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<BaseLayout title={title} description={description}>
  <section class="px-6 pt-20 pb-10 md:pt-28">
    <div class="mx-auto max-w-3xl">
      <span
        class="inline-flex items-center rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-muted-foreground"
      >
        Legal
      </span>
      <h1 class="mt-5 text-4xl font-medium tracking-tight text-balance md:text-6xl">{title}</h1>
      <p class="mt-5 max-w-2xl text-base text-pretty text-muted-foreground md:text-lg">{summary}</p>
      <p class="mt-6 text-sm text-muted-foreground">
        Last updated <time datetime={site.legalUpdated}>{updated}</time>
      </p>
    </div>
  </section>

  <section class="px-6 pb-10">
    <div class="legal mx-auto max-w-3xl border-t border-border pt-10">
      <slot />
    </div>
  </section>
</BaseLayout>

<style>
  /* The page body is slotted in from the page, so these rules need :global to reach it. */
  .legal :global(h2) {
    margin-top: 2.75rem;
    font-size: 1.5rem;
    line-height: 1.25;
    font-weight: 500;
  }
  .legal :global(h2:first-child) {
    margin-top: 0;
  }
  .legal :global(p),
  .legal :global(ul) {
    margin-top: 1rem;
    line-height: 1.7;
    color: var(--muted-foreground);
  }
  .legal :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal :global(li + li) {
    margin-top: 0.5rem;
  }
  .legal :global(strong) {
    font-weight: 500;
    color: var(--foreground);
  }
  .legal :global(a) {
    color: var(--foreground);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (min-width: 768px) {
    .legal :global(h2) {
      font-size: 1.875rem;
    }
    .legal :global(p),
    .legal :global(ul) {
      font-size: 1.0625rem;
    }
  }
</style>
